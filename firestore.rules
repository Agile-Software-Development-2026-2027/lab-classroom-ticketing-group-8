
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isProfessor() {
      return isAuthenticated()
        && userProfile().role == 'PROFESSOR';
    }

    function isAdmin() {
      return isAuthenticated()
        && userProfile().role == 'ADMIN';
    }

    function isAssignedDepartment(departmentRef) {
      return isAuthenticated()
        && userProfile().get('department', null) == departmentRef;
    }

    function isValidReference(reference, collectionName) {
      return reference is path
        && reference ==
          /databases/$(database)/documents/$(collectionName)/$(reference[4])
        && exists(reference);
    }

    function hasApprovedDepartmentAccess(departmentRef) {
      let accessId =
        request.auth.uid + '_' + departmentRef[4];

      let accessPath =
        /databases/$(database)/documents/departmentAccessRequests/$(accessId);

      return exists(accessPath)
        && get(accessPath).data.status == 'APPROVED'
        && get(accessPath).data.professor ==
          /databases/$(database)/documents/users/$(request.auth.uid)
        && get(accessPath).data.department == departmentRef;
    }

    function canBookDepartment(departmentRef) {
      return isAssignedDepartment(departmentRef)
        || (
          isProfessor()
          && hasApprovedDepartmentAccess(departmentRef)
        );
    }

    // Story 34: validazione degli orari di Ateneo.
    function isDaylightSaving(t) {
      let year = t.year();

      let marchSunday =
        31 - (timestamp.date(year, 3, 31).dayOfWeek() % 7);

      let octoberSunday =
        31 - (timestamp.date(year, 10, 31).dayOfWeek() % 7);

      return t >=
          timestamp.date(year, 3, marchSunday)
          + duration.value(1, 'h')
        && t <
          timestamp.date(year, 10, octoberSunday)
          + duration.value(1, 'h');
    }

    function toRomeTime(t) {
      return t + duration.value(
        isDaylightSaving(t) ? 2 : 1,
        'h'
      );
    }

    function pad2(number) {
      return number < 10
        ? '0' + string(number)
        : string(number);
    }

    function localDateKey(t) {
      return string(t.year()) + '-'
        + pad2(t.month()) + '-'
        + pad2(t.day());
    }

    function isValidUniversityHours() {
      let data = request.resource.data;

      let localStart = toRomeTime(data.startsAt);
      let localEnd = toRomeTime(data.endsAt);

      let startMinutes =
        localStart.hours() * 60
        + localStart.minutes();

      let endMinutes =
        localEnd.hours() * 60
        + localEnd.minutes();

      return localDateKey(localStart) == data.date
        && localStart.date() == localEnd.date()
        && startMinutes >= 510
        && startMinutes <= 1110
        && endMinutes <= 1170
        && data.endsAt - data.startsAt >= duration.value(60, 'm')
        && data.startsAt.seconds() == 0
        && data.endsAt.seconds() == 0
        && data.startsAt.nanos() == 0
        && data.endsAt.nanos() == 0;
    }

    function isValidBookingData() {
      let data = request.resource.data;
      let reason = data.get('rejectionReason', '');

      let fields = [
        'classroom',
        'department',
        'professor',
        'professorName',
        'date',
        'startsAt',
        'endsAt',
        'status',
      ];

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(
          fields.concat(['rejectionReason'])
        )
        && isValidReference(data.classroom, 'classrooms')
        && isValidReference(data.department, 'departments')
        && isValidReference(data.professor, 'users')
        && get(data.classroom).data.department == data.department
        && data.professorName is string
        && data.professorName.size() > 0
        && data.professorName.size() <= 100
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startsAt is timestamp
        && data.endsAt is timestamp
        && data.startsAt < data.endsAt
        && data.status in [
          'PENDING',
          'APPROVED',
          'REJECTED'
        ]
        && reason is string
        && reason.size() <= 500
        && (
          data.status == 'REJECTED'
            ? reason.trim().size() > 0
            : reason == ''
        );
    }

    match /users/{userId} {
      allow get: if isAuthenticated()
        && (
          request.auth.uid == userId
          || isAdmin()
        );
    }

    match /departments/{departmentId} {
      allow read: if true;
    }

    match /classrooms/{classroomId} {
      allow read: if true;

      allow update: if isAdmin()
        && isAssignedDepartment(resource.data.department)
        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'lastBookingApproval'
        ])
        && request.resource.data.lastBookingApproval is timestamp;
    }

    // Story 43 + Story 52.
    match /departmentAccessRequests/{requestId} {

      // Il professore legge solo le proprie richieste.
      // L'admin può leggere quelle del suo dipartimento.
      allow get: if (
        isProfessor()
        && requestId.matches(
          '^' + request.auth.uid + '_[^/]+$'
        )
        && (
          resource == null
          || (
            resource.data.professor ==
              /databases/$(database)/documents/users/$(request.auth.uid)
            && requestId ==
              request.auth.uid + '_'
              + resource.data.department[4]
          )
        )
      ) || (
        isAdmin()
        && isAssignedDepartment(resource.data.department)
      );

      // Sono ammesse soltanto query dimostrabilmente
      // limitate al dipartimento dell'admin.
      allow list: if isAdmin()
        && isAssignedDepartment(resource.data.department);

      // Story 43: creazione di una richiesta PENDING.
      allow create: if isProfessor()
        && request.resource.data.keys().hasAll([
          'professor',
          'department',
          'professorName',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'professor',
          'department',
          'professorName',
          'status',
          'createdAt'
        ])
        && isValidReference(
          request.resource.data.professor,
          'users'
        )
        && isValidReference(
          request.resource.data.department,
          'departments'
        )
        && request.resource.data.professor ==
          /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.department !=
          userProfile().get('department', null)
        && request.resource.data.professorName is string
        && request.resource.data.professorName.size() > 0
        && request.resource.data.professorName.size() <= 100
        && request.resource.data.professorName ==
          userProfile().get('displayName', 'Docente')
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt is timestamp
        && requestId ==
          request.auth.uid + '_'
          + request.resource.data.department[4];

      allow update: if isAdmin()
        && isAssignedDepartment(resource.data.department)
        && resource.data.status == 'PENDING'
        && requestId ==
          resource.data.professor[4] + '_'
          + resource.data.department[4]
        && request.resource.data.status in [
          'APPROVED',
          'REJECTED'
        ]
        && request.resource.data.decidedAt == request.time
        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasAll([
          'status',
          'decidedAt'
        ])
        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'status',
          'decidedAt'
        ]);

      allow delete: if false;
    }

    match /bookingRequest/{bookingId} {

      allow read: if resource.data.status == 'APPROVED'
        || (
          isAdmin()
          && isAssignedDepartment(resource.data.department)
        )
        || (
          isProfessor()
          && resource.data.professor ==
            /databases/$(database)/documents/users/$(request.auth.uid)
        );

      allow create: if isProfessor()
        && isValidBookingData()
        && isValidUniversityHours()
        && canBookDepartment(
          request.resource.data.department
        )
        && request.resource.data.professor ==
          /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.status == 'PENDING';

      // Regole amministrative delle prenotazioni esistenti.
      allow update: if isAdmin()
        && isAssignedDepartment(resource.data.department)
        && isValidBookingData()
        && resource.data.status == 'PENDING'
        && request.resource.data.status in [
          'APPROVED',
          'REJECTED'
        ]
        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly(
          request.resource.data.status == 'REJECTED'
            ? ['status', 'rejectionReason']
            : ['status']
        );

      allow delete: if isProfessor()
        && resource.data.professor ==
          /databases/$(database)/documents/users/$(request.auth.uid)
        && resource.data.status in [
          'PENDING',
          'APPROVED'
        ]
        && resource.data.startsAt > request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
