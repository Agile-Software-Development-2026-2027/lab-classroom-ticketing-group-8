rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isProfessor() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'PROFESSOR';
    }

    function hasRequiredBookingFields() {
      return request.resource.data.keys().hasAll([
        'date',
        'startTime',
        'endTime',
        'classroom',
        'status',
        'professorId'
      ]);
    }

    match /users/{userId} { 
      allow get: if isAuthenticated()
                 && request.auth.uid == userId;
    }

    // Catalogo pubblico utilizzato dal calendario.
    match /departments/{departmentId} {
      allow read: if true;
    }

    match /classrooms/{classroomId} {
      allow read: if true;
    }

    // Il calendario pubblico mostra solo prenotazioni approvate.
    // Solo i professori autenticati possono creare una richiesta con stato PENDING.
    match /bookingRequest/{bookingId} {
      allow read: if resource.data.status == 'APPROVED';
      allow create: if isProfessor()
                    && request.resource.data.professorId == request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    && hasRequiredBookingFields()
                    && request.resource.data.startTime < request.resource.data.endTime;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
