rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId}
// Fields:
//   - role: string (required, 'PROFESSOR' | 'ADMIN')
//   - email: string (optional)
//   - displayName: string (optional)
//   - universityId: string (optional)
//
// Collection: departments
// Document ID: {departmentId}
// Public read access for calendar catalog.
//
// Collection: classrooms
// Document ID: {classroomId}
// Public read access for calendar catalog.
//
// Collection: bookingRequest
// Document ID: {bookingId}
// Strictly contains the following 8 fields:
//   - classroom: reference to /databases/$(database)/documents/classrooms/{classroomId} (required)
//   - department: reference to /databases/$(database)/documents/departments/{departmentId} (required)
//   - professor: reference to /databases/$(database)/documents/users/{userId} (required)
//   - professorName: string (required)
//   - date: string (required, "YYYY-MM-DD")
//   - startsAt: timestamp (required)
//   - endsAt: timestamp (required)
//   - status: string (required, "PENDING" on creation)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isProfessor() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'PROFESSOR';
    }

    function hasStrictBookingFields() {
      return request.resource.data.keys().hasAll([
        'classroom',
        'department',
        'professor',
        'professorName',
        'date',
        'startsAt',
        'endsAt',
        'status'
      ]) && request.resource.data.keys().hasOnly([
        'classroom',
        'department',
        'professor',
        'professorName',
        'date',
        'startsAt',
        'endsAt',
        'status'
      ]);
    }

    function isValidBookingData() {
      return request.resource.data.classroom is path
        && request.resource.data.department is path
        && request.resource.data.professor is path
        && request.resource.data.professorName is string
        && request.resource.data.professorName.size() > 0
        && request.resource.data.professorName.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.status is string;
    }

    match /users/{userId} { 
      allow get: if isAuthenticated()
                 && request.auth.uid == userId;
    }

    // Catalogo pubblico utilizzato dal calendario.
    match /departments/{departmentId} {
      allow read: if true;
    }

    match /classrooms/{classroomId} {
      allow read: if true;
    }

    // Il calendario pubblico mostra solo prenotazioni approvate.
    // Solo i professori autenticati possono creare una richiesta con stato PENDING.
    match /bookingRequest/{bookingId} {
      allow read: if resource.data.status == 'APPROVED';
      allow create: if isProfessor()
                    && request.resource.data.professor == /databases/$(database)/documents/users/$(request.auth.uid)
                    && request.resource.data.status == 'PENDING'
                    && hasStrictBookingFields()
                    && isValidBookingData()
                    && request.resource.data.startsAt < request.resource.data.endsAt;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}