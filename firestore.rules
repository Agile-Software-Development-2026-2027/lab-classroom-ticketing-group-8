
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isProfessor() {
      return isAuthenticated()
        && userProfile().role == 'PROFESSOR';
    }

    function isAdmin() {
      return isAuthenticated()
        && userProfile().role == 'ADMIN';
    }

    function isAssignedDepartment(departmentRef) {
      return isAuthenticated()
        && userProfile().get('department', null) == departmentRef;
    }

    function isValidReference(reference, collectionName) {
      return reference is path
        && reference ==
          /databases/$(database)/documents/$(collectionName)/$(reference[4])
        && exists(reference);
    }

    function isValidBookingData() {
      let data = request.resource.data;
      let reason = data.get('rejectionReason', '');

      let fields = [
        'classroom',
        'department',
        'professor',
        'professorName',
        'date',
        'startsAt',
        'endsAt',
        'status',

      ];

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields.concat(['rejectionReason']))
        && isValidReference(data.classroom, 'classrooms')
        && isValidReference(data.department, 'departments')
        && isValidReference(data.professor, 'users')
        && get(data.classroom).data.department == data.department
        && data.professorName is string
        && data.professorName.size() > 0
        && data.professorName.size() <= 100
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startsAt is timestamp
        && data.endsAt is timestamp
        && data.startsAt < data.endsAt
        && data.status in ['PENDING', 'APPROVED', 'REJECTED']
        && reason is string
        && reason.size() <= 500
        && (data.status == 'REJECTED'
          ? reason.trim().size() > 0
          : reason == '');
    }

    match /users/{userId} {
      allow get: if isAuthenticated()
        && (
          request.auth.uid == userId
          || isAdmin()
        );
    }

    match /departments/{departmentId} {
      allow read: if true;
    }

    match /classrooms/{classroomId} {
      allow read: if true;
    }

    match /bookingRequest/{bookingId} {

      allow read: if
        resource.data.status == 'APPROVED'
        || (
          isAdmin()
          && isAssignedDepartment(resource.data.department)
        )
        || (
          isProfessor()
          && resource.data.professor ==
            /databases/$(database)/documents/users/$(request.auth.uid)
        );

      allow create: if
        isProfessor()
        && isValidBookingData()
        && isAssignedDepartment(request.resource.data.department)
        && request.resource.data.professor ==
          /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.status == 'PENDING';

      allow update: if
        isAdmin()
        && isAssignedDepartment(resource.data.department)
        && isValidBookingData()
        && resource.data.status == 'PENDING'
        && request.resource.data.status in ['APPROVED', 'REJECTED']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          request.resource.data.status == 'REJECTED'
            ? ['status', 'rejectionReason']
            : ['status']
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
