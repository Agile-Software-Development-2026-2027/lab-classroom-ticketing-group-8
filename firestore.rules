rules_version = '2';

// Schema delle richieste:
// classroom, department, professor: riferimenti Firestore.
// professorName, date (YYYY-MM-DD), status: stringhe.
// startsAt, endsAt: timestamp.
// I ruoli sono letti da users/{uid}, non modificabile dal client.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isProfessor() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'PROFESSOR';
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Verifica collezione ed esistenza del documento referenziato.
    function isValidReference(reference, collectionName) {
      return reference is path
        && reference == /databases/$(database)/documents/$(collectionName)/$(reference[4])
        && exists(reference);
    }

    function isValidBookingData() {
      let data = request.resource.data;
      let fields = [
        'classroom',
        'department',
        'professor',
        'professorName',
        'date',
        'startsAt',
        'endsAt',
        'status'
      ];

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && isValidReference(data.classroom, 'classrooms')
        && isValidReference(data.department, 'departments')
        && isValidReference(data.professor, 'users')
        && get(data.classroom).data.department == data.department
        && data.professorName is string
        && data.professorName.size() > 0
        && data.professorName.size() <= 100
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startsAt is timestamp
        && data.endsAt is timestamp
        && data.startsAt < data.endsAt
        && data.status in ['PENDING', 'APPROVED', 'REJECTED'];
    }

    // Ciascuno legge il proprio profilo.
    // Gli admin possono leggere anche i profili dei docenti.
    match /users/{userId} {
      allow get: if isAuthenticated()
        && (request.auth.uid == userId || isAdmin());
    }

    // Catalogo pubblico.
    match /departments/{departmentId} {
      allow read: if true;
    }

    match /classrooms/{classroomId} {
      allow read: if true;
    }

    match /bookingRequest/{bookingId} {

      // Pubblico: solo approvate. Admin: tutte le richieste.
      allow read: if resource.data.status == 'APPROVED'
        || isAdmin();

      // Il professore crea richieste proprie in stato PENDING.
      allow create: if isProfessor()
        && isValidBookingData()
        && request.resource.data.professor == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.status == 'PENDING';

      // L'admin approva o rifiuta cambiando soltanto lo stato.
      allow update: if isAdmin()
        && isValidBookingData()
        && resource.data.status == 'PENDING'
        && request.resource.data.status in ['APPROVED', 'REJECTED']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // Tutte le altre operazioni sono negate.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
